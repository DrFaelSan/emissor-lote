<Window
    x:Class="NEO_e.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NEO_e.WinUI.Controls"
    xmlns:local="using:NEO_e.WinUI.AttachedProperties"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
    Title="NFS-e em lote - NEO-e">

    <Grid
        x:Name="RootGrid"
        Loaded="OnLoaded"
        Background="{StaticResource BackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Arial" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarRow" Grid.Row="0" Margin="24,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="TitleStack"
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <TextBlock Text="NFS-e em lote" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Style="{StaticResource ChipStyle}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding AppVersion}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" />
                </Border>
            </StackPanel>

            <controls:DynamicIslandControl x:Name="DynamicIsland" Grid.Column="1" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ShellStyle}" Margin="24,4,24,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox
                            Content="Incluir falha de teste"
                            IsChecked="{Binding SimulationFailureEnabled, Mode=TwoWay}"
                            Visibility="{Binding IsSimulationMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0"
                            Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Command="{Binding ToggleSimulationModeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8CA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SimulationModeButtonText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Certificados" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" Text="{Binding CertificateFolder, Mode=OneWay}" Margin="0,0,12,0" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding ChooseCertificateFolderCommand}" Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" />
                                    <TextBlock Text="Procurar" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ReloadCertificatesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0" ToolTipService.ToolTip="Atualizar certificados">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Destino" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="{Binding DestinationFolder, Mode=OneWay}" Margin="0,12,12,0" />
                        <Button Grid.Row="1" Grid.Column="2" Command="{Binding ChooseDestinationFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" />
                                <TextBlock Text="Procurar" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding SimulationOutputLabel}" Margin="0,12,0,0"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding IsSimulationMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" MaxWidth="450" HorizontalAlignment="Stretch">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Canvas.ZIndex="1" />
                                <TextBox
                                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Padding="36,10,12,10"
                                    Margin="0"
                                    PlaceholderText="Buscar empresa, CNPJ/CPF ou arquivo"
                                    ToolTipService.ToolTip="Buscar empresa, CNPJ/CPF ou arquivo..." />
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VisibleCertificateCount}" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="empresa(s) listada(s)" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                                <Border x:Name="CertificatesBorder"
                                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="10">
                                <toolkit:DataGrid ItemsSource="{Binding VisibleCertificates}" Margin="0"
                                                  AutoGenerateColumns="False"
                                                  Background="Transparent"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  RowBackground="{StaticResource SurfaceBrush}"
                                                  AlternatingRowBackground="{StaticResource SurfaceMutedBrush}"
                                                  HorizontalGridLinesBrush="{StaticResource CardBorderBrush}"
                                                  VerticalGridLinesBrush="Transparent"
                                                  GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column"
                                                  RowHeight="42"
                                                  ColumnHeaderHeight="44"
                                                  SelectionMode="Extended"
                                                  FontSize="13"
                                                  FontFamily="Segoe UI Variable Text, Segoe UI, Arial">
                                    <toolkit:DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="primitives:DataGridColumnHeader">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="FontSize" Value="12" />
                                        </Style>
                                    </toolkit:DataGrid.ColumnHeaderStyle>
                                    <toolkit:DataGrid.Columns>
                                        <toolkit:DataGridCheckBoxColumn Header="Sel." Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                        <toolkit:DataGridTextColumn Header="Empresa" Binding="{Binding Subject}" Width="*" IsReadOnly="True" />
                                        <toolkit:DataGridTextColumn Header="CNPJ/CPF" Binding="{Binding Cnpj}" Width="135" IsReadOnly="True" />
                                        <toolkit:DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="170" IsReadOnly="True" />
                                        <toolkit:DataGridTextColumn Header="Último NSU" Binding="{Binding UltimoNsu}" Width="110" IsReadOnly="True" />
                                        <toolkit:DataGridTextColumn Header="Validade" Binding="{Binding ValidUntilText}" Width="100" IsReadOnly="True" />
                                        <toolkit:DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="140" IsReadOnly="True" />
                                        <toolkit:DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*" IsReadOnly="True" />
                                        <toolkit:DataGridTemplateColumn Header="Senha" Width="120">
                                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <PasswordBox
                                                        local:PasswordBoxHelper.BindPassword="True"
                                                        local:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding HasPrivateKey, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTipService.ToolTip="Senha mantida em memória durante a sessão"
                                                        Padding="8,4"
                                                        Margin="4,0"
                                                        VerticalContentAlignment="Center" />
                                                </DataTemplate>
                                            </toolkit:DataGridTemplateColumn.CellTemplate>
                                        </toolkit:DataGridTemplateColumn>
                                    </toolkit:DataGrid.Columns>
                                </toolkit:DataGrid>
                            </Border>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="0,44,0,0" Orientation="Horizontal" IsHitTestVisible="False"
                                        Visibility="{Binding VisibleCertificateCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="18" Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding EmptyStateMessage}" MaxWidth="520"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0"
                        Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Progresso:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding SyncProgressText}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ProgressBar Grid.Column="2" Width="240" Height="8"
                                         Minimum="0" Maximum="{Binding TotalEmpresas}" Value="{Binding EmpresasProcessadas, Mode=OneWay}" />
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" MaxHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LogMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"
                                                       TextWrapping="Wrap" Margin="0,2,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="SELEÇÃO" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Marcar todas" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="Desmarcar" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="CONFERÊNCIA" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Analisar Lacunas" Command="{Binding AnalyzeGapsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="Recuperar Lacunas" Command="{Binding RecoverGapsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DOCUMENTOS" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Exportar Excel" Command="{Binding ExportExecutionCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="Indexar Recebidos" Command="{Binding IndexReceivedDocumentsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalEmpresas}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="EMPRESAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalXmlGravados}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="{Binding DocumentCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBoxStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalErros}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Text="COM ERRO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CanStartSyncReason}" Margin="20,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Baixar desde o início" Command="{Binding ResetNsuCommand}" Style="{StaticResource SecondaryButtonStyle}" />

                            <Button Command="{Binding CancelSyncCommand}" Style="{StaticResource DangerButtonStyle}"
                                    Visibility="{Binding IsOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Parar Processo" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding StartSyncCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="32,12" Margin="0" IsEnabled="{Binding CanStartSync}" ToolTipService.ToolTip="{Binding CanStartSyncReason}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StartSyncButtonText}" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding StatusMessage}" Margin="0,16,0,0"
                                   TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
