<UserControl x:Class="NEO_e.App.Controls.DynamicIslandControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Loaded="OnIslandLoaded"
             MouseEnter="OnIslandMouseEnter"
             MouseLeave="OnIslandMouseLeave"
             shell:WindowChrome.IsHitTestVisibleInChrome="True">

    <UserControl.Resources>
        <Style x:Key="IslandEnvChipStyle" TargetType="Border" BasedOn="{StaticResource IslandChipStyle}">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EnvironmentDescription}" Value="PRODUCAO (API REAL)">
                    <Setter Property="Background" Value="#3A1A1A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IslandEnvChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource IslandAccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EnvironmentDescription}" Value="PRODUCAO (API REAL)">
                    <Setter Property="Foreground" Value="{StaticResource IslandDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="IslandRoot"
            Width="40"
            Height="40"
            CornerRadius="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ClipToBounds="True"
            IsHitTestVisible="False"
            Style="{StaticResource IslandPillStyle}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="IslandTransform" Y="-80" />
        </Border.RenderTransform>

        <Grid x:Name="IslandContent" Opacity="0" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource IslandEnvChipStyle}"
                    ToolTip="Restrita usa o servico de homologacao da API. Producao acessa a API real.">
                <TextBlock Text="{Binding EnvironmentDescription}" Style="{StaticResource IslandEnvChipTextStyle}"/>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource IslandDividerStyle}"/>

            <Border x:Name="NotifyChip"
                    Grid.Column="2"
                    Style="{StaticResource IslandChipStyle}"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="NotifyIcon"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock x:Name="NotifyText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IslandTextPrimaryBrush}"
                               VerticalAlignment="Center"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                <TextBlock Style="{StaticResource IslandTextStyle}" FontSize="12" Text="{Binding TotalEmpresas}"/>
                <TextBlock Style="{StaticResource IslandMutedTextStyle}" Text="empresas" Margin="4,0,0,0"/>
                <TextBlock Text="&#xB7;" FontSize="11" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource IslandTextTertiaryBrush}"/>
                <TextBlock Style="{StaticResource IslandTextStyle}" FontSize="12" Text="{Binding TotalXmlGravados}"/>
                <TextBlock Style="{StaticResource IslandMutedTextStyle}" Text="XML" Margin="4,0,0,0"/>
                <TextBlock Text="&#xB7;" FontSize="11" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource IslandTextTertiaryBrush}"/>
                <TextBlock Style="{StaticResource IslandTextStyle}" FontSize="12" Text="{Binding TotalErros}" Foreground="{StaticResource IslandDangerBrush}"/>
                <TextBlock Style="{StaticResource IslandMutedTextStyle}" Text="erros" Margin="4,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0"
                        Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Width="110" Height="6"
                             Minimum="0"
                             Maximum="{Binding TotalEmpresas}"
                             Value="{Binding EmpresasProcessadas, Mode=OneWay}"
                             Background="{StaticResource IslandBackgroundPressedBrush}"
                             Foreground="{StaticResource IslandAccentBrush}"/>
                <TextBlock Style="{StaticResource IslandMutedTextStyle}" Margin="10,0,0,0">
                    <Run Text="{Binding EmpresasProcessadas, Mode=OneWay}" Foreground="White" FontWeight="SemiBold"/>
                    <Run Text="/"/>
                    <Run Text="{Binding TotalEmpresas, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <Border Grid.Column="5" Style="{StaticResource IslandDividerStyle}"/>

            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Button Content="&#xE72C;"
                        Style="{StaticResource IslandIconButtonStyle}"
                        Command="{Binding ResetNsuCommand}"
                        ToolTip="Baixar desde o inicio (requer confirmacao em duas etapas)"/>
                <Button Content="&#xE71A;"
                        Style="{StaticResource IslandIconButtonStyle}"
                        Foreground="{StaticResource IslandDangerBrush}"
                        Command="{Binding CancelSyncCommand}"
                        Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Parar"/>
                <Button Content="&#xE896;"
                        Style="{StaticResource IslandPrimaryIconButtonStyle}"
                        Command="{Binding StartSyncCommand}"
                        IsEnabled="{Binding CanStartSync}"
                        ToolTip="{Binding CanStartSyncReason}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
