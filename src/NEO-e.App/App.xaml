<Application x:Class="NEO_e.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NEO_e.App">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F1EA" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFCF7" />
        <SolidColorBrush x:Key="InkBrush" Color="#202522" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="#66706B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0E6B5A" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#D7EAE2" />
        <SolidColorBrush x:Key="WarningBrush" Color="#9A5A16" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>
