{
  "App": {
    "Certificates": {
      "FolderPath": "C:\\Certificados",
      "AutoDiscover": true,
      "SupportedExtensions": [".pfx", ".p12"]
    },
    "Storage": {
      "DestinationPath": "C:\\NotasFiscais",
      "FolderStructure": "YearMonthType",
      "CreateSubfolders": true
    },
    "Adn": {
      "BaseUrlRestrita": "https://adn.producaorestrita.nfse.gov.br/",
      "BaseUrlProducao": "https://adn.nfse.gov.br/",
      "TimeoutSeconds": 60,
      "MaxBatchSize": 50,
      "RateLimitPerMinute": 300,
      "Retry": {
        "MaxAttempts": 3,
        "BaseDelayMs": 500,
        "MaxDelayMs": 10000,
        "BackoffMultiplier": 2.0,
        "RespectRetryAfter": true,
        "RetryableStatusCodes": [429, 500, 502, 503, 504]
      }
    },
    "Environment": {
      "Active": "Restrita",
      "RequireExplicitConfirmationForProducao": true
    },
    "Logging": {
      "LogFilePath": "logs/neo-e-.log",
      "MinimumLevel": "Information",
      "RetainedFileCountLimit": 31,
      "FileSizeLimitBytes": 10485760
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "NEO_e.Infrastructure.Http.AdnHttpClient": "Debug"
      }
    }
  }
}