<Window x:Class="NEO_e.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NEO_e.App.AttachedProperties"
        Title="NFS-e em lote - NEO-e" Height="840" Width="1280"
        MinHeight="720" MinWidth="980" Loaded="OnLoaded"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <Window.Resources>
        <Style x:Key="EnvironmentChipStyle" TargetType="Border" BasedOn="{StaticResource ChipStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EnvironmentDescription}" Value="PRODUCAO (API REAL)">
                    <Setter Property="Background" Value="{StaticResource DangerMutedBrush}" />
                    <Setter Property="BorderBrush" Value="#F0C9C4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EnvironmentChipTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EnvironmentDescription}" Value="PRODUCAO (API REAL)">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource ShellStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho Principal -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NFS-e em lote" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Border Style="{StaticResource ChipStyle}">
                            <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <Border Style="{StaticResource EnvironmentChipStyle}"
                                ToolTip="Restrita usa o serviço de homologação da API. Produção acessa a API real.">
                            <TextBlock Text="{Binding EnvironmentDescription}" Style="{StaticResource EnvironmentChipTextStyle}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Incluir falha de teste" IsChecked="{Binding SimulationFailureEnabled}"
                                  Visibility="{Binding IsSimulationMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Command="{Binding ToggleSimulationModeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8CA;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SimulationModeButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Card de Pastas -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Certificados" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" Text="{Binding CertificateFolder, Mode=OneWay}" Margin="0,0,12,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding ChooseCertificateFolderCommand}" Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0"/>
                                    <TextBlock Text="Procurar"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ReloadCertificatesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0" ToolTip="Atualizar certificados">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Destino" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="{Binding DestinationFolder, Mode=OneWay}" Margin="0,12,12,0"/>
                        <Button Grid.Row="1" Grid.Column="2" Command="{Binding ChooseDestinationFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0"/>
                                <TextBlock Text="Procurar"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding SimulationOutputLabel}" Margin="0,12,0,0"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding IsSimulationMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Grid Principal -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Barra de Busca Moderna com Icone -->
                            <Grid Grid.Column="0" MaxWidth="450" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Panel.ZIndex="1"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="36,10,12,10" Margin="0"
                                         ToolTip="Buscar empresa, CNPJ ou arquivo..." />
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VisibleCertificateCount}" FontWeight="Bold" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="empresa(s) listada(s)" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                <DataGrid ItemsSource="{Binding CertificatesView}" Margin="0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Sel." Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                        <DataGridTextColumn Header="Empresa" Binding="{Binding Subject}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="CNPJ/CPF" Binding="{Binding Cnpj}" Width="135" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="170" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Último NSU" Binding="{Binding UltimoNsu}" Width="110" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Validade" Binding="{Binding ValidUntil, StringFormat=d}" Width="100" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Senha" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <PasswordBox x:Name="PasswordBox"
                                                                 local:PasswordBoxHelper.BindPassword="True"
                                                                 local:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding HasPrivateKey, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                 ToolTip="Senha mantida apenas em memória durante o lote"
                                                                 Padding="8,4" Margin="4,0" VerticalContentAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Empty State Aprimorado (Icone + Mensagem) -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VisibleCertificateCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" 
                                      Fill="{StaticResource CardBorderBrush}" Width="56" Height="56" Stretch="Uniform" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding EmptyStateMessage}" MaxWidth="400"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Console de Log / Progresso -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0"
                        Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Progresso:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding SyncProgressText}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ProgressBar Grid.Column="2" Width="240" Height="8"
                                         Minimum="0" Maximum="{Binding TotalEmpresas}" Value="{Binding EmpresasProcessadas, Mode=OneWay}"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" MaxHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LogMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"
                                                       TextWrapping="Wrap" Margin="0,2,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- Ações Secundárias -->
                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="SELEÇÃO" Style="{StaticResource SectionTitleStyle}"/>
                            <WrapPanel>
                                <Button Content="Marcar todas" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="Desmarcar" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="CONFERÊNCIA" Style="{StaticResource SectionTitleStyle}"/>
                            <WrapPanel>
                                <Button Content="Analisar Lacunas" Command="{Binding AnalyzeGapsCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="Recuperar Lacunas" Command="{Binding RecoverGapsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DOCUMENTOS" Style="{StaticResource SectionTitleStyle}"/>
                            <WrapPanel>
                                <Button Content="Exportar Excel" Command="{Binding ExportExecutionCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="Indexar Recebidos" Command="{Binding IndexReceivedDocumentsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Rodapé Principal -->
                <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalEmpresas}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="EMPRESAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalXmlGravados}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DocumentCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBoxStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalErros}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Text="COM ERRO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CanStartSyncReason}" Margin="20,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Baixar desde o início" Command="{Binding ResetNsuCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            
                            <Button Command="{Binding CancelSyncCommand}" Style="{StaticResource DangerButtonStyle}"
                                    Visibility="{Binding IsOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Parar Processo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding StartSyncCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="32,12" Margin="0" IsEnabled="{Binding CanStartSync}" ToolTip="{Binding CanStartSyncReason}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StartSyncButtonText}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding StatusMessage}" Margin="0,16,0,0"
                                   TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>