<Window x:Class="NEO_e.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NEO_e.App.AttachedProperties"
        Title="NFS-e em lote - NEO-e" Height="800" Width="1280"
        MinHeight="720" MinWidth="980" Loaded="OnLoaded"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="EnvironmentChipStyle" TargetType="Border" BasedOn="{StaticResource ChipStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EnvironmentDescription}" Value="PRODUCAO (API REAL)">
                    <Setter Property="Background" Value="{StaticResource DangerMutedBrush}" />
                    <Setter Property="BorderBrush" Value="#F0C9C4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EnvironmentChipTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EnvironmentDescription}" Value="PRODUCAO (API REAL)">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Style="{StaticResource ShellStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NFS-e em lote" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Style="{StaticResource ChipStyle}">
                            <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <Border Style="{StaticResource EnvironmentChipStyle}"
                                ToolTip="Restrita usa o servico de homologacao da API. Producao acessa a API real. Simulacao e local e nao acessa a API.">
                            <TextBlock Text="{Binding EnvironmentDescription}" Style="{StaticResource EnvironmentChipTextStyle}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Incluir falha de teste" IsChecked="{Binding SimulationFailureEnabled}"
                                  Visibility="{Binding IsSimulationMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="{Binding SimulationModeButtonText}" Command="{Binding ToggleSimulationModeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Certificados" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" Text="{Binding CertificateFolder, Mode=OneWay}" Margin="0,0,12,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Escolher pasta" Command="{Binding ChooseCertificateFolderCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="Atualizar" Command="{Binding ReloadCertificatesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0"/>
                        </StackPanel>

                        <TextBlock Text="Destino" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,4,12,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="{Binding DestinationFolder, Mode=OneWay}" Margin="0,4,12,0"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Escolher pasta" Command="{Binding ChooseDestinationFolderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding SimulationOutputLabel}" Margin="0,8,0,0"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding IsSimulationMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Empresas do lote" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VisibleCertificateCount}" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBlock Text="empresa(s)" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Buscar empresa, CNPJ ou arquivo..." Margin="0,0,0,10"/>

                        <Grid Grid.Row="2">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <DataGrid ItemsSource="{Binding CertificatesView}" Margin="0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Sel." Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="44"/>
                                        <DataGridTextColumn Header="Empresa" Binding="{Binding Subject}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="CNPJ/CPF" Binding="{Binding Cnpj}" Width="115" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="150" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Último NSU" Binding="{Binding UltimoNsu}" Width="95" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Validade" Binding="{Binding ValidUntil, StringFormat=d}" Width="85" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="130" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Senha" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <PasswordBox x:Name="PasswordBox"
                                                                 local:PasswordBoxHelper.BindPassword="True"
                                                                 local:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding HasPrivateKey, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                 ToolTip="Senha mantida apenas em memória durante o lote"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding EmptyStateMessage}" MaxWidth="580"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VisibleCertificateCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0"
                        Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Progresso:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding SyncProgressText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ProgressBar Grid.Column="2" Width="200" Height="8"
                                         Minimum="0" Maximum="{Binding TotalEmpresas}" Value="{Binding EmpresasProcessadas, Mode=OneWay}"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="10" MaxHeight="120">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                                <ItemsControl ItemsSource="{Binding LogMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"
                                                       TextWrapping="Wrap" Margin="0,1,0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="SELECAO" Style="{StaticResource SectionTitleStyle}"/>
                            <WrapPanel>
                                <Button Content="Marcar todas" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="Desmarcar" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="CONFERENCIA" Style="{StaticResource SectionTitleStyle}"/>
                            <WrapPanel>
                                <Button Content="Analisar Lacunas" Command="{Binding AnalyzeGapsCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Analisa lacunas de NSU nos certificados selecionados"/>
                                <Button Content="Recuperar Lacunas" Command="{Binding RecoverGapsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                                        ToolTip="Recupera documentos das lacunas identificadas"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DOCUMENTOS" Style="{StaticResource SectionTitleStyle}"/>
                            <WrapPanel>
                                <Button Content="Exportar Excel" Command="{Binding ExportExecutionCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Exporta os resultados da ultima execucao para Excel"/>
                                <Button Content="Indexar Recebidos" Command="{Binding IndexReceivedDocumentsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                                        ToolTip="Varre os XMLs da pasta de destino e indexa os documentos recebidos"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalEmpresas}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="EMPRESAS" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalXmlGravados}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DocumentCountLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalErros}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Text="COM ERRO" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CanStartSyncReason}" Margin="16,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Baixar desde o início" Command="{Binding ResetNsuCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Requer confirmação em duas etapas"/>
                            <Button Content="Parar" Command="{Binding CancelSyncCommand}" Style="{StaticResource DangerButtonStyle}"
                                    Visibility="{Binding IsOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="{Binding StartSyncButtonText}" Command="{Binding StartSyncCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="26,10" Margin="0" IsEnabled="{Binding CanStartSync}" ToolTip="{Binding CanStartSyncReason}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding StatusMessage}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
