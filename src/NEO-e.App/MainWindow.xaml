<Window x:Class="NEO_e.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NEO_e.App.AttachedProperties"
        Title="NFS-e em lote - NEO-e" Height="900" Width="1280"
        MinHeight="720" MinWidth="980" Loaded="OnLoaded"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Configuração de Pastas e Ambiente -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="NFS-e em lote" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding EnvironmentDescription}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"
                               ToolTip="Restrita usa o servico de homologacao da API. Producao acessa a API real. Simulacao e local e nao acessa a API."/>
                    <Button Content="{Binding SimulationModeButtonText}" Command="{Binding ToggleSimulationModeCommand}"/>
                    <CheckBox Content="Incluir falha de teste" IsChecked="{Binding SimulationFailureEnabled}"
                              Visibility="{Binding IsSimulationMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Certificados" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="True" Text="{Binding CertificateFolder, Mode=OneWay}"/>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Escolher pasta" Command="{Binding ChooseCertificateFolderCommand}"/>
                    <Button Content="Atualizar" Command="{Binding ReloadCertificatesCommand}"/>
                </StackPanel>

                <TextBlock Text="Destino" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="5" IsReadOnly="True" Text="{Binding DestinationFolder, Mode=OneWay}"/>
                <Button Content="Escolher pasta" Grid.Row="2" Grid.Column="2" Command="{Binding ChooseDestinationFolderCommand}"/>
                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding SimulationOutputLabel}" Margin="5,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding IsSimulationMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- 2. Grid de Empresas e Busca -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra superior da Grid -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             ToolTip="Buscar empresa, CNPJ ou arquivo..." />
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0">
                        <TextBlock Text="{Binding VisibleCertificateCount}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                        <TextBlock Text="empresa(s)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid principal da carteira -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding CertificatesView}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" HeadersVisibility="Column" Background="#FDFDFD"
                          SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                          AlternationCount="2" RowBackground="White" AlternatingRowBackground="#FAF9F4">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Sel." Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="Empresa" Binding="{Binding Subject}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="CNPJ/CPF" Binding="{Binding Cnpj}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="190" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Último NSU" Binding="{Binding UltimoNsu}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Validade" Binding="{Binding ValidUntil, StringFormat=d}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="175" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Senha" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <PasswordBox x:Name="PasswordBox" 
                                                 local:PasswordBoxHelper.BindPassword="True"
                                                 local:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding HasPrivateKey, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 ToolTip="Senha mantida apenas em memória durante o lote"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="{Binding EmptyStateMessage}" MaxWidth="580" Margin="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisibleCertificateCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 3. Progresso e Log de Execução (UI-006) -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="5" Margin="0,15,0,0" Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Progresso atual -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Progresso:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding SyncProgressText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <ProgressBar Grid.Column="2" Width="200" Height="20" 
                                 Minimum="0" Maximum="{Binding TotalEmpresas}" Value="{Binding EmpresasProcessadas, Mode=OneWay}"
                                 Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
                
                <!-- Log visual (últimas mensagens) -->
                <Border Grid.Row="1" Background="#F8F8F8" CornerRadius="3" Padding="8" MaxHeight="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                        <ItemsControl ItemsSource="{Binding LogMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" 
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"
                                               TextWrapping="Wrap" Margin="0,1,0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- 4. Ações de Lacunas, Recuperação e Exportação -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="5" Margin="0,15,0,0">
            <Grid>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Ferramentas:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Marcar todas" Command="{Binding SelectAllCommand}"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="1" BorderBrush="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                    <Button Content="Desmarcar" Command="{Binding ClearSelectionCommand}"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="1" BorderBrush="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                    <Button Content="Analisar Lacunas" Command="{Binding AnalyzeGapsCommand}" 
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" 
                            BorderThickness="1" BorderBrush="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"
                            ToolTip="Analisa lacunas de NSU nos certificados selecionados"/>
                    <Button Content="Recuperar Lacunas" Command="{Binding RecoverGapsCommand}" 
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" 
                            BorderThickness="1" BorderBrush="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"
                            ToolTip="Recupera documentos das lacunas identificadas"/>
                    <Button Content="Exportar Excel" Command="{Binding ExportExecutionCommand}"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" 
                            BorderThickness="1" BorderBrush="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"
                            ToolTip="Exporta os resultados da ultima execucao para Excel"/>
                    <Button Content="Indexar Recebidos" Command="{Binding IndexReceivedDocumentsCommand}"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="1" BorderBrush="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"
                            ToolTip="Varre os XMLs da pasta de destino e indexa os documentos recebidos"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 5. Rodapé de Ações e Contadores -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="5" Margin="0,15,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding TotalEmpresas}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="EMPRESAS" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding TotalXmlGravados}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DocumentCountLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding TotalErros}" FontSize="20" FontWeight="Bold" Foreground="DarkRed"/>
                        <TextBlock Text="COM ERRO" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Baixar desde o início" Command="{Binding ResetNsuCommand}" 
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" 
                            BorderThickness="1" BorderBrush="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"
                            ToolTip="Requer confirmação em duas etapas"/>
                            
                    <Button Content="Parar" Command="{Binding CancelSyncCommand}" Background="DarkRed" Margin="0,0,10,0" 
                            Visibility="{Binding IsOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            
                    <Button Content="{Binding StartSyncButtonText}" Command="{Binding StartSyncCommand}" Padding="30,10"
                            IsEnabled="{Binding CanStartSync}" ToolTip="{Binding CanStartSyncReason}"/>
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CanStartSyncReason}" Margin="10,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding StatusMessage}" Margin="0,10,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>