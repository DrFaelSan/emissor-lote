<Window x:Class="NEO_e.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NEO-e | Sincronizacao fiscal"
        Height="760"
        Width="1240"
        MinHeight="620"
        MinWidth="960"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NEO-e" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Sincronizacao de documentos fiscais" Foreground="{StaticResource MutedInkBrush}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource AccentLightBrush}" Padding="14,9" CornerRadius="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding ActiveEnvironmentLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Certificados" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CertificateFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,10" Padding="8" />
                <Button Grid.Row="0" Grid.Column="2" Content="Escolher pasta" Click="ChooseCertificatesFolder" Margin="0,0,18,10" />

                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <TextBlock Text="Ambiente" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Width="130" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Destino" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="8" />
                <Button Grid.Row="1" Grid.Column="2" Content="Escolher pasta" Click="ChooseDestinationFolder" Margin="0,0,18,0" />
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Estrutura" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Width="150" ItemsSource="{Binding FolderStructures}" SelectedItem="{Binding SelectedFolderStructure, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Ler certificados" Command="{Binding ReloadCertificatesCommand}" />
                <Button Content="Limpar lista" Command="{Binding ClearCertificatesCommand}" Background="Transparent" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
                <Button Content="Selecionar visiveis" Command="{Binding SelectAllCommand}" Background="Transparent" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
                <Button Content="Limpar selecao" Command="{Binding ClearSelectionCommand}" Background="Transparent" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Buscar" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="190" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,0,14,0" />
                <TextBlock Text="{Binding VisibleCertificateCount, StringFormat={}{0} visivel(is)}" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="3" Background="{StaticResource PanelBackgroundBrush}">
            <DataGrid ItemsSource="{Binding CertificatesView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="46"
                      Margin="1">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Usar" Binding="{Binding Selected, Mode=TwoWay}" Width="58" />
                    <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="1.4*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Titular" Binding="{Binding Subject}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Validade" Binding="{Binding ValidUntil, StringFormat=dd/MM/yyyy}" Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="Thumbprint" Binding="{Binding Thumbprint}" Width="1.4*" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Senha" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <PasswordBox PasswordChanged="CertificatePasswordChanged" Padding="6" VerticalContentAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Situacao" Binding="{Binding Status}" Width="140" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource PanelBackgroundBrush}" Padding="12" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Baixar XML" Command="{Binding StartSyncCommand}" Padding="16,6" Margin="0,0,8,0" />
                <Button Content="Baixar desde o inicio" Command="{Binding ResetNsuCommand}" Padding="16,6" Margin="0,0,8,0" Background="Transparent" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
                <Button Content="Parar" Command="{Binding CancelSyncCommand}" Padding="16,6" Background="Transparent" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
                <TextBlock Text="{Binding SyncProgressText}" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Background="{StaticResource AccentBrush}" Padding="14" Margin="0,16,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" />
                    <Button Content="Validar configuracao" Command="{Binding ValidateConfigurationCommand}" Margin="18,0,0,0" Background="White" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <TextBlock Text="Senhas nao sao persistidas." Foreground="White" Opacity="0.82" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
